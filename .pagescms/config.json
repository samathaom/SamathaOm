{
  "media": {
    "input": "static/images",
    "output": "/images"
  },
  "collections": [
    {
      "name": "Article",
      "id": "articles",
      "type": "folder",
      "path": "content/articles",
      "extension": "md",
      "format": "yaml-frontmatter",
      "fields": [
        { "name": "Title", "id": "title", "type": "string" },
        { "name": "Date", "id": "date", "type": "date", "default": "now" },
        { "name": "Draft", "id": "draft", "type": "boolean", "default": false },
        { "name": "Body", "id": "body", "type": "rich-text" }
      ]
    }
  ]
}