{{- $ctx := . -}}

{{- /* Version-agnostic extraction of PaperMod dict context */ -}}
{{- if .cxt }}
  {{- $ctx = .cxt }}
{{- end }}

{{- $covertable := false -}}

{{- with $ctx }}
    {{- if .Params.thumbnail -}}
        {{- $covertable = .Params.thumbnail -}}

    {{- else if .Params.slider_images -}}
        {{- range first 1 .Params.slider_images -}}
            {{- $covertable = .image -}}
        {{- end -}}
    {{- end -}}

    {{- if $covertable }}
        <figure class="entry-cover">
            <img loading="lazy" src="{{ $covertable | relURL }}" alt="{{ .Title }}">
        </figure>
    {{- else -}}
        {{- partial "post_thumbnail.html" . -}}
    {{- end -}}
{{- end }}