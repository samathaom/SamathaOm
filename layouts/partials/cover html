{{- $ctx := . -}}

{{- if .cxt }}
  {{- $ctx = .cxt }}
{{- end }}

{{- $covertable := "" -}}

{{- with $ctx }}
    {{- if .Params.thumbnail -}}
        {{- $covertable = .Params.thumbnail -}}

    {{- else if .Params.slider_images -}}
        {{- range first 1 .Params.slider_images -}}
            {{- $covertable = .image -}}
        {{- end -}}
    {{- end -}}
{{- end -}}

{{- if ne $covertable "" }}
    <div class="entry-cover-wrapper" style="margin-bottom: 20px; width: 100%;">
        {{- $image_url := $covertable | absURL -}}
        {{- if hasPrefix $covertable "/" }}
            {{- $image_url = printf "%s%s" site.BaseURL (strings.TrimPrefix "/" $covertable) -}}
        {{- end }}
        <img loading="lazy" src="{{ $image_url }}" alt="Post Thumbnail" style="width: 100%; height: auto; border-radius: var(--radius); object-fit: cover; max-height: 240px; display: block;">
    </div>
{{- else -}}
    {{- partial "post_thumbnail.html" . -}}
{{- end -}}